Frontend:
  impl: SimpleO3
  ipc: 6
  inst_window_depth: 200
  clock_ratio: 6
  num_expected_insts: 100000000
  traces: 
  - /scratch/elior.k/cloudsuite-traces/in-memory-analytics-core-1/trace.cpu0:0
  - /scratch/elior.k/cloudsuite-traces/in-memory-analytics-core-1/trace.cpu0:1
  - /scratch/elior.k/cloudsuite-traces/in-memory-analytics-core-1/trace.cpu0:2
  - /scratch/elior.k/cloudsuite-traces/in-memory-analytics-core-1/trace.cpu0:3
  cows_enable: false # cows disable
  cows_replacement: "LRU_nohit"
  llc_latency: 50
  llc_linesize: 64
  llc_associativity: 8
  llc_num_mshr_per_core: 16
  llc_capacity_per_core: 4MB

  cows_dram_latency_on_translation: 200
  cows_cache_access_latency: 10
  cows_cache2llc_ratio: 1
  cows_cache_assoc: 8
  dram_page_bytes: 8KB
  cows_stats_file: cows_stats.out

  Translation:
    impl: NoTranslation
    max_addr: 9223372036854775807


MemorySystem:
  impl: GenericDRAM
  clock_ratio: 1

  DRAM:
    impl: DDR5-cow
    drampower_enable: true
    high_temp: false
    org:
      preset: DDR5_64Gb_x8
      channel: 4
      rank: 2
    timing:
      preset: DDR5_8000C
    voltage:
    current:
    RFM:
      BRC: 2

  Controller:
    impl: Generic
    Scheduler:
      impl: FRFCFS
    RefreshManager:
      impl: AllBank
    RowPolicy:
      impl: ClosedRowPolicy
      cap: 8
    plugins:

  AddrMapper:
    impl: RoBaRaChCo
